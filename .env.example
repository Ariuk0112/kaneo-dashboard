# Kaneo API (server-side only — never prefix these with NEXT_PUBLIC_)
KANEO_API_URL=https://api.kaneo.ufe.edu.mn/api
KANEO_API_TOKEN=
# "Requests" (REQ) project in the UFE Tech workspace
KANEO_PROJECT_ID=oon14b0oskd5nmec1ki0wvj5

# How long fetched Kaneo data is cached, in seconds
KANEO_REVALIDATE_SECONDS=300

# Kaneo user ids whose resolutions count as "Azaa AI" (comma-separated).
